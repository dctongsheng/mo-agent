# Mo — environment template
# Copy to ~/.hermes-mo/.env and fill in the values you need.
# Most model settings can also be configured in-app (endpoint library).

# --- Core API server -------------------------------------------------------
# Bearer key the local API server requires. Generate a random string.
API_SERVER_KEY=

# Do NOT set API_SERVER_CORS_ORIGINS here. Mo pins it to "null" (the origin a
# file:// renderer sends) in server/mo-gateway.py. A value in this file wins —
# it is read through the profile secret scope, which bypasses the environment —
# so an entry like `API_SERVER_CORS_ORIGINS=*` silently reopens the gateway's
# unauthenticated /health endpoints to any website you visit.

# --- Model providers -------------------------------------------------------
# Any OpenAI-compatible provider works. Set the key(s) for the provider you
# selected in ~/.hermes-mo/config.yaml. Examples:
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# Custom providers are configured under `custom_providers:` in config.yaml.

# --- Memory (OpenViking) ---------------------------------------------------
# URL of a running OpenViking server for long-term semantic memory.
# Leave unset to disable the OpenViking backend.
OPENVIKING_ENDPOINT=http://127.0.0.1:1933
# OPENVIKING_API_KEY=

# --- Self-evolution tuning (optional) --------------------------------------
# Skip semantic recall for messages shorter than N characters (0 = always).
MO_RECALL_MIN_CHARS=6
