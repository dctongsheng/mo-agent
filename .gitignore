# Dependencies
node_modules/
**/node_modules/
*.venv/
.venv/
venv/
hermes-venv/

# Build output
app/dist/
app/src/renderer/dist/
app/release/
dist/
build/
*.asar

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime / local state
.env
.env.*
!.env.example
*.log
.DS_Store

# Secrets — belt and braces. Nothing of the sort is tracked today; these rules
# exist so an accidental `git add -A` can't be the thing that leaks a key.
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*
credentials.json
service-account*.json

# Editor
.idea/
.vscode/
*.swp

# Local agent / IDE state
.claude/

# Vendored core runtime markers (written by hermes_bootstrap.py at first run)
vendor/hermes-agent/.hermes-bootstrap-complete
node_modules
app/node_modules
