{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Relative paths and no baseUrl: newer TypeScript rejects non-relative
    // entries here (TS5090). Mirrors the aliases in src/renderer/vite.config.ts.
    "paths": {
      "@store/*": ["./src/renderer/store/*"],
      "@ui/*": ["./src/renderer/ui/*"],
      "@services/*": ["./src/renderer/services/*"],
      "@styles/*": ["./src/renderer/styles/*"]
    }
  },
  "include": ["src/renderer/**/*"],
  "exclude": ["node_modules", "src/renderer/dist"]
}
