{
  "name": "mo-desktop",
  "version": "0.1.0",
  "description": "Mo · 桌面端自进化 Agent — a desktop self-evolving agent, powered by the Hermes Agent core (Nous Research, MIT)",
  "license": "MIT",
  "author": "Taiyi-AI-Lab",
  "homepage": "https://github.com/dctongsheng/mo-agent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dctongsheng/mo-agent.git",
    "directory": "app"
  },
  "bugs": {
    "url": "https://github.com/dctongsheng/mo-agent/issues"
  },
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build:ts": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build -c src/renderer/vite.config.ts",
    "build:all": "npm run build:ts && npm run build:renderer",
    "dev": "npm run build:all && (tsc -p tsconfig.main.json -w --preserveWatchOutput & vite -c src/renderer/vite.config.ts build --watch & sleep 3 && electron .)",
    "start": "npm run build:all && electron .",
    "dist": "npm run build:all && electron-builder",
    "dist:local": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run dist -- --publish never"
  },
  "dependencies": {
    "dompurify": "^3.4.9",
    "electron-store": "^8.2.0",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^2.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "ai.taiyi.mo",
    "productName": "貘 Mo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/dist/**/*",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "python-server"
      },
      {
        "from": "../vendor/hermes-agent",
        "to": "hermes-agent"
      }
    ],
    "mac": {
      "artifactName": "Mo-${version}-${arch}-mac.${ext}",
      "category": "public.app-category.productivity",
      "target": [
        "zip"
      ]
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
